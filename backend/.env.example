# ── Server ──────────────────────────────────────────────
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://hospital:CHANGE_ME@db:5432/hospital
# DATABASE_SSL=true                # set when using a managed Postgres that requires SSL
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_64_CHARS_MIN   # openssl rand -hex 32
CORS_ORIGINS=https://staff.shekareyehospital.example
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=15

# ── Hospital details (shown in app, receipts, assistant) ─
HOSPITAL_PHONE=+91-XXXXX-XXXXX
HOSPITAL_EMERGENCY_PHONE=+91-XXXXX-XXXXX
HOSPITAL_WHATSAPP=
HOSPITAL_EMAIL=info@shekareyehospital.example
HOSPITAL_WEBSITE=https://shekareyehospital.example
HOSPITAL_ADDRESS=Full street address, Area, Bengaluru, Karnataka 5600XX
HOSPITAL_MAPS_URL=https://maps.app.goo.gl/XXXX
HOSPITAL_GSTIN=

# ── First admin login (used by `npm run seed`) ──────────
SEED_ADMIN_PHONE=+91XXXXXXXXXX

# ── SMS OTP (MSG91, DLT-registered template required in India) ──
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# App Store / Play Store reviewer demo login (fixed OTP for this one number only)
REVIEWER_PHONE=+919999999999
REVIEWER_OTP=246810

# ── Payments (Razorpay). Leave empty to use test/mock mode ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SLOT_HOLD_MINUTES=10

# ── Booking rules ───────────────────────────────────────
BOOKING_MAX_DAYS_AHEAD=30
CANCEL_CUTOFF_HOURS=2

# ── Optional: AI answers for the help assistant (Claude API) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
