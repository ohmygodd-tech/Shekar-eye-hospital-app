{
  "expo": {
    "name": "Shekar Eye Hospital",
    "slug": "shekar-eye-hospital",
    "scheme": "shekareye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Book eye appointments, view eye test results and glasses prescriptions, pay online and get care reminders from Shekar Eye Hospital.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B6E99"
    },
    "ios": {
      "bundleIdentifier": "com.shekareyehospital.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "We send appointment confirmations, reminders and report-ready alerts."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] }
        ]
      }
    },
    "android": {
      "package": "com.shekareyehospital.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B6E99"
      },
      "permissions": ["android.permission.POST_NOTIFICATIONS", "android.permission.INTERNET"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      ["expo-notifications", { "color": "#0B6E99" }],
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#0B6E99" }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiUrl": "https://api.shekareyehospital.example/api",
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
